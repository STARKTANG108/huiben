# baoyu-image-gen 环境变量（复制为 .env 后填写）
# 放在：.baoyu-skills/.env

# 推荐：复用 Pictale「模型配置」里的 suxi（OpenAI 兼容）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://new.suxi.ai/v1
OPENAI_IMAGE_MODEL=jimeng-3.0

# 或其它 Provider（任选其一）
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# DASHSCOPE_API_KEY=
# ARK_API_KEY=
# REPLICATE_API_TOKEN=
# JIMENG_ACCESS_KEY_ID=
# JIMENG_SECRET_ACCESS_KEY=
